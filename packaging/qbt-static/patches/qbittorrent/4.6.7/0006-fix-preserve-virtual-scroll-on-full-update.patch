+const rowHeight = 20;
+const viewportHeight = 60;
+const hiddenHeaderHeight = 20;
+const scrollTopForIndex = (index) => index * rowHeight;
+const scrollHeightForRows = (rowCount) => hiddenHeaderHeight + (rowCount * rowHeight);
+const maxScrollTopForRows = (rowCount) => Math.max(0, scrollHeightForRows(rowCount) - viewportHeight);
+
 let server;
 let browser;
 let baseUrl;
@@ -81,6 +88,174 @@ async function openSmokePage() {
     return page;
 }
 
+async function loadAndScroll(page, rowCount, rowIndex) {
+    await page.evaluate((count) => window.browserSmokeApi.loadTorrents(count), rowCount);
+    await page.evaluate((index) => window.browserSmokeApi.scrollToIndex(index), rowIndex);
+    const state = await page.evaluate(() => window.browserSmokeApi.getTableState());
+    assert.equal(state.scrollTop, scrollTopForIndex(rowIndex));
+    return state;
+}
+
+test("full update preserves scroll without selection", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 1500);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds([]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient());
+
+        assert.equal(state.scrollTop, scrollTopForIndex(1500));
+        assert.equal(state.clientHeight, viewportHeight);
+        assert.deepEqual(state.selectedRows, []);
+        assert.equal(state.windowRange.startIndex, 1498);
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("full update preserves scroll with top-row selection stored off-screen", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 1500);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds(["torrent-0"]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient());
+
+        assert.equal(state.scrollTop, scrollTopForIndex(1500));
+        assert.deepEqual(state.selectedRows, ["torrent-0"]);
+        assert.notEqual(state.firstMountedRowId, "torrent-0");
+        assert.equal(state.windowRange.startIndex, 1498);
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("full update preserves scroll with mid-row selection", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 1500);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds(["torrent-1500"]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient());
+
+        assert.equal(state.scrollTop, scrollTopForIndex(1500));
+        assert.deepEqual(state.selectedRows, ["torrent-1500"]);
+        assert.equal(state.windowRange.startIndex, 1498);
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("full update clamps scroll after row-count shrink", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 2500);
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient({
+            nextCount: 120
+        }));
+
+        assert.equal(state.scrollTop, maxScrollTopForRows(120));
+        assert.equal(state.scrollHeight, scrollHeightForRows(120));
+        assert.equal(state.windowRange.startIndex, 116);
+        assert.equal(state.windowRange.endIndex, 119);
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("full update drops removed selected rows safely", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 1500);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds(["torrent-1500", "torrent-1501"]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient({
+            removedRowIds: ["torrent-1500"]
+        }));
+
+        assert.equal(state.scrollTop, scrollTopForIndex(1500));
+        assert.deepEqual(state.selectedRows, ["torrent-1501"]);
+        assert.ok(!state.mountedRows.includes("torrent-1500"));
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("full update with zero rows lands safely at scrollTop zero", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 1500);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds(["torrent-1500"]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient({
+            nextCount: 0
+        }));
+
+        assert.equal(state.scrollTop, 0);
+        assert.deepEqual(state.selectedRows, []);
+        assert.deepEqual(state.mountedRows, []);
+        assert.equal(state.windowRange.startIndex, 0);
+        assert.equal(state.windowRange.endIndex, -1);
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("full update remains safe across sorting changes", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 700);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds(["torrent-42", "torrent-2999"]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.fullUpdateLikeClient({
+            removedRowIds: ["torrent-42"],
+            reverseNameSort: true
+        }));
+
+        assert.equal(state.scrollTop, scrollTopForIndex(700));
+        assert.deepEqual(state.selectedRows, ["torrent-2999"]);
+        assert.equal(state.windowRange.startIndex, 698);
+    }
+    finally {
+        await page.close();
+    }
+});
+
+test("incremental refresh keeps existing virtual scroll behavior unchanged", async () => {
+    const page = await openSmokePage();
+
+    try {
+        await loadAndScroll(page, 3000, 1234);
+        await page.evaluate(() => window.browserSmokeApi.setSelectedRowIds(["torrent-1234"]));
+
+        const state = await page.evaluate(() => window.browserSmokeApi.incrementalRefresh({
+            updatedIndexes: [10, 1234],
+            activeIndexes: [1234]
+        }));
+
+        assert.equal(state.scrollTop, scrollTopForIndex(1234));
+        assert.deepEqual(state.selectedRows, ["torrent-1234"]);
+        assert.equal(state.windowRange.startIndex, 1232);
+    }
+    finally {
+        await page.close();
+    }
+});
+
