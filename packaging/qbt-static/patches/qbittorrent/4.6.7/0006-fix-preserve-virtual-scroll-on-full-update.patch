diff --git a/src/webui/www/private/scripts/dynamicTable.js b/src/webui/www/private/scripts/dynamicTable.js
index 5c76577..1555d99 100644
--- a/src/webui/www/private/scripts/dynamicTable.js
+++ b/src/webui/www/private/scripts/dynamicTable.js
@@ -705,6 +705,71 @@ window.qBittorrent.DynamicTable = (function() {
                 this.virtualRefreshFrameId = setTimeout(refresh, 0);
         },
 
+        captureViewportState: function() {
+            const tableDiv = $(this.dynamicTableDivId);
+            if (!tableDiv)
+                return null;
+
+            return {
+                scrollTop: tableDiv.scrollTop || 0,
+                clientHeight: tableDiv.clientHeight || 0,
+                scrollHeight: tableDiv.scrollHeight || 0
+            };
+        },
+
+        restoreViewportState: function(viewportState) {
+            const tableDiv = $(this.dynamicTableDivId);
+            if (!viewportState || !tableDiv)
+                return null;
+
+            const cancelPendingRefresh = function() {
+                if (this.virtualRefreshFrameId === null)
+                    return;
+
+                if (typeof window.cancelAnimationFrame === 'function')
+                    window.cancelAnimationFrame(this.virtualRefreshFrameId);
+                clearTimeout(this.virtualRefreshFrameId);
+                this.virtualRefreshFrameId = null;
+            }.bind(this);
+
+            cancelPendingRefresh();
+
+            const savedScrollTop = Number.parseInt(viewportState.scrollTop, 10);
+            const maxScrollTop = Math.max(0, (tableDiv.scrollHeight || 0) - (tableDiv.clientHeight || 0));
+            const clampedScrollTop = Math.min(Math.max(Number.isFinite(savedScrollTop) ? savedScrollTop : 0, 0), maxScrollTop);
+
+            tableDiv.scrollTop = clampedScrollTop;
+            cancelPendingRefresh();
+            this.refreshVirtualTableWindow(false);
+
+            return {
+                scrollTop: tableDiv.scrollTop || 0,
+                clientHeight: tableDiv.clientHeight || 0,
+                scrollHeight: tableDiv.scrollHeight || 0,
+                maxScrollTop: maxScrollTop
+            };
+        },
+
+        filterExistingRowIds: function(rowIds) {
+            const filteredRowIds = [];
+            if (!rowIds)
+                return filteredRowIds;
+
+            const rowIndexById = this.rowOrderState ? this.rowOrderState.rowIndexById : null;
+            for (let i = 0; i < rowIds.length; ++i) {
+                const rowId = `${rowIds[i]}`;
+                if (rowIndexById) {
+                    if (rowIndexById[rowId] !== undefined)
+                        filteredRowIds.push(rowId);
+                }
+                else if (this.rows && this.rows.has(rowId)) {
+                    filteredRowIds.push(rowId);
+                }
+            }
+
+            return filteredRowIds;
+        },
+
         assignRowIdentity: function(tr, rowId) {
             tr.setProperty("data-row-id", rowId);
             tr['rowId'] = rowId;
diff --git a/test/webui/client-fullupdate-order.test.mjs b/test/webui/client-fullupdate-order.test.mjs
new file mode 100644
index 0000000..818900f
--- /dev/null
+++ b/test/webui/client-fullupdate-order.test.mjs
@@ -0,0 +1,70 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import test from "node:test";
+import {fileURLToPath} from "node:url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.resolve(__dirname, "../..");
+const clientSourcePath = path.join(repoRoot, "src/webui/www/private/scripts/client.js");
+
+const clientSource = fs.readFileSync(clientSourcePath, "utf8");
+
+const findRequired = (source, needle, label, fromIndex = 0) => {
+    const index = source.indexOf(needle, fromIndex);
+    assert.notEqual(index, -1, `expected ${label} in full_update lifecycle`);
+    return index;
+};
+
+test("client full_update preserves viewport before reselecting rows", () => {
+    const fullUpdateStart = findRequired(
+        clientSource,
+        "const full_update = (response['full_update'] === true);",
+        "full_update branch");
+    const fullUpdateEnd = findRequired(
+        clientSource,
+        "syncRequestInProgress = false;",
+        "end of sync success handler",
+        fullUpdateStart);
+    const fullUpdateLifecycle = clientSource.slice(fullUpdateStart, fullUpdateEnd);
+
+    const selectedRowsIndex = findRequired(
+        fullUpdateLifecycle,
+        "torrentsTable.selectedRowsIds()",
+        "selectedRowsIds() capture");
+    const captureViewportIndex = findRequired(
+        fullUpdateLifecycle,
+        "torrentsTable.captureViewportState()",
+        "captureViewportState() before clear()");
+    const clearIndex = findRequired(
+        fullUpdateLifecycle,
+        "torrentsTable.clear()",
+        "clear() after viewport capture");
+    const updateTableIndex = findRequired(
+        fullUpdateLifecycle,
+        "torrentsTable.updateTable(full_update)",
+        "updateTable(full_update) after rebuild");
+    const restoreViewportIndex = findRequired(
+        fullUpdateLifecycle,
+        "torrentsTable.restoreViewportState(",
+        "restoreViewportState() after updateTable(full_update)");
+
+    assert.ok(
+        selectedRowsIndex < captureViewportIndex,
+        "selectedRowsIds() must happen before captureViewportState()");
+    assert.ok(
+        captureViewportIndex < clearIndex,
+        "captureViewportState() must happen before clear()");
+    assert.ok(
+        clearIndex < updateTableIndex,
+        "clear() must happen before updateTable(full_update)");
+    assert.ok(
+        updateTableIndex < restoreViewportIndex,
+        "updateTable(full_update) must happen before restoreViewportState()");
+
+    const restoreAndReselect = fullUpdateLifecycle.slice(restoreViewportIndex);
+    assert.match(
+        restoreAndReselect,
+        /torrentsTable\.reselectRows\s*\(\s*torrentsTable\.filterExistingRowIds\s*\(\s*torrentsTableSelectedRows\s*\)\s*\)/,
+        "restoreViewportState() must be followed by reselectRows(filterExistingRowIds(torrentsTableSelectedRows))");
+});
