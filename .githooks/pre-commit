#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

run_privacy_scan() {
    python3 - <<'PY'
from pathlib import Path
import re
import subprocess

patterns = [
    r'/home/[\w.-]+/',
    r'/mnt/[a-z]/Users/[\w.-]+',
    r'/Users/[\w.-]+/',
    r'[A-Za-z]:\\Users\\[^\\\s]+',
    r'gh[pousr]_[A-Za-z0-9]{30,}',
    r'github_pat_[A-Za-z0-9_]{30,}',
]
upstream_examples = 'packaging/qbt-static/patches/qbittorrent/4.6.7/source/src/base/bittorrent/torrent.h'
synthetic_root = '/'.join(('', 'home', 'user', 'torrents'))
failed = False
for name in subprocess.check_output(['git', 'ls-files', '-z']).decode().split('\0'):
    path = Path(name)
    if not name or not path.is_file():
        continue
    payload = path.read_bytes()
    if b'\0' in payload:
        continue
    for number, line in enumerate(payload.decode('utf-8', errors='replace').splitlines(), 1):
        if name == upstream_examples and line.lstrip().startswith('//'):
            line = re.sub(re.escape(synthetic_root) + r'(?=[/`\s]|$)', '<synthetic-path>', line)
        if any(re.search(pattern, line) for pattern in patterns):
            print(f'privacy scan failed: {name}:{number} (value redacted)')
            failed = True
raise SystemExit(1 if failed else 0)
PY
}

# The patch payloads preserve upstream formatting, so skip them here.
git diff --check --cached -- . ':(exclude)packaging/qbt-static/patches/**'
bash -n \
    packaging/qbt-static/run-static-build.sh \
    packaging/qbt-static/in-container-build.sh \
    packaging/qbt-static/stage-release-assets.sh
python3 -m pytest tests/test_qbt_static_wrapper.py -q
node --test tests/test_webui_filters.js
run_privacy_scan
